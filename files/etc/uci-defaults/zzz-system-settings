#!/bin/sh
# 系统默认设置：LuCI 简体中文 + dockerd 自动启动
# 在其他 uci-defaults 之后执行（文件名 zzz- 排序靠后）

# 1. LuCI 默认语言设为简体中文（zh-cn，连字符）
uci -q delete "luci.main.lang"
uci -q set "luci.main.lang"="zh-cn"
uci -q commit "luci"

# 2. 修复 dockerman 镜像加速器格式错误（"- https://..." 导致 daemon.json 解析失败）
#    清除错误的 mirror 列表，让 dockerd 用默认配置启动
uci -q delete dockerd.lists
uci -q commit dockerd

# 3. dockerd 开机自启并立即启动
/etc/init.d/dockerd enable
/etc/init.d/dockerd start >/dev/null 2>&1

exit 0
