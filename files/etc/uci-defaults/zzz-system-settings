#!/bin/sh
# 系统默认设置：LuCI 简体中文（iStore 通过 i18n 读取此语言）
# 在其他 uci-defaults 之后执行（文件名 zzz- 排序靠后）

# LuCI 默认语言设为简体中文（zh-cn，连字符）
uci -q delete "luci.main.lang"
uci -q set "luci.main.lang"="zh-cn"
uci -q commit "luci"

# Alist 监听端口改为用户设置的 10088（luci 界面填的 port 没映射到 listen_http_port）
uci -q set alist.config.listen_http_port="10088"
uci -q commit alist

# 禁用 openlist（用户用 alist，避免端口冲突）
uci -q set openlist.config.enabled="0"
uci -q commit openlist
/etc/init.d/openlist stop >/dev/null 2>&1

exit 0
