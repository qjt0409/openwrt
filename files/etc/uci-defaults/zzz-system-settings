#!/bin/sh
# 系统默认设置：LuCI 简体中文 + alist 开机自启
# 在其他 uci-defaults 之后执行（文件名 zzz- 排序靠后）

# 1. LuCI 默认语言设为简体中文（zh-cn，连字符）
uci -q delete "luci.main.lang"
uci -q set "luci.main.lang"="zh-cn"
uci -q commit "luci"

# 2. alist 开机自启并立即启动
/etc/init.d/alist enable
/etc/init.d/alist start >/dev/null 2>&1

# 3. 易有云开机自启并立即启动
/etc/init.d/linkease enable
/etc/init.d/linkease start >/dev/null 2>&1

exit 0
